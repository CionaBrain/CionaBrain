{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/connectome.ts", "src/simulator.ts", "src/live-runtime.ts", "src/worker.ts", "src/server.ts", "tests-ts/**/*.ts"]
}
